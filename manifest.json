{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.4",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "author": "METRONOMIC",
  "homepage_url": "https://github.com/RemoteMetering/azure-devops-standup-timer",
  "permissions": ["storage"],
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "commands": {
    "reset-timer": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "__MSG_commandResetDescription__"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://dev.azure.com/*"],
      "js": [
        "shared/defaults.js",
        "shared/names.js",
        "shared/storage.js",
        "content/selectors.js",
        "content/taskboard-timer.js"
      ],
      "css": ["content/timer.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "incognito": "spanning",
  "browser_specific_settings": {
    "gecko": {
      "id": "standup-timer@metronomic.global",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
